# Postgres
POSTGRES_DB=nexuscrm
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
DATABASE_URL=jdbc:postgresql://postgres:5432/nexuscrm

# API
NEXUS_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NEXUS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXUS_BFF_API_KEY=change-me-bff-api-key
NEXUS_BFF_ORIGIN=http://localhost:3001
NEXUS_SEED=true

# BFF / web
BFF_PORT=3001
WEB_ORIGIN=http://localhost:8088
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Gmail OAuth (optional — leave blank to use the mock mailbox)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8088/bff/oauth/gmail/callback
